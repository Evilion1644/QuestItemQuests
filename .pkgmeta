package-as: QLens
enable-nolib-creation: no
enable-toc-creation: no
plain-copy:
  - QLens/QuestItemQuestsData.lua
  - QLens/Titles.lua
  - QLens_Guide/Data.lua
  - QLens_Guide/ClassicRewards.lua
manual-changelog:
  filename: .build/CHANGELOG.md
  markup-type: markdown
move-folders:
  QLens/QLens_Guide: QLens_Guide
  QLens/QLens: QLens
ignore:
  - .github
  - .gitignore
  - .pkgmeta
  - .build
  - docs
  - scripts
  - tests
  - tools
  - THIRD_PARTY_NOTICES.md
  - release-config.json
